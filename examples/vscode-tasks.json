{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "run-qg",
      "type": "shell",
      "command": "bash",
      "args": [
        "${env:HOME}/.cursor/agentic-quality-gate/scripts/run-qg.sh"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AGENTIC_QUALITY_GATE_HOME": "${env:HOME}/.cursor/agentic-quality-gate",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true,
        "echo": true,
        "showReuseMessage": false
      },
      "group": {
        "kind": "test",
        "isDefault": true
      },
      "detail": "Live quality gate in the Terminal panel (scrollable logs)"
    },
    {
      "label": "run-qg (strict)",
      "type": "shell",
      "command": "bash",
      "args": [
        "${env:HOME}/.cursor/agentic-quality-gate/scripts/run-qg.sh",
        "--strict"
      ],
      "options": {
        "cwd": "${workspaceFolder}",
        "env": {
          "AGENTIC_QUALITY_GATE_HOME": "${env:HOME}/.cursor/agentic-quality-gate",
          "PYTHONUNBUFFERED": "1"
        }
      },
      "problemMatcher": [],
      "presentation": {
        "reveal": "always",
        "panel": "dedicated",
        "focus": true
      },
      "detail": "Same as run-qg but exit 1 on fail (matches pre-push)"
    }
  ]
}
